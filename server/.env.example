# ARRAKIS server settings (copy to server/.env and fill locally).
PORT=3001
ARRAKIS_DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
ARRAKIS_BETA_ACCESS_CODE=

# For production, set CORS_ORIGINS to the exact deployed frontend origin and set a strong random ARRAKIS_BETA_ACCESS_CODE.
# AI provider keys stay server-side. Do not paste them into frontend code or VITE_* variables.
ARRAKIS_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternatives (leave unset unless configured):
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
