# Local frontend defaults. VITE_* values are public and must never contain secrets.
VITE_API_BASE_URL=http://localhost:3001
VITE_REQUIRE_BETA_ACCESS=false

# In Vercel production settings set: VITE_API_BASE_URL=https://<your-render-api>.onrender.com
# In Vercel production settings set: VITE_REQUIRE_BETA_ACCESS=true
